# =============================================================================
# Ponašanje potrošača u turizmu — AI asistent kolegija
# Veleučilište Baltazar Zaprešić · Management u turizmu i ugostiteljstvu
#
# Kopirajte u .env.local i popunite. Projekt je POTPUNO ODVOJEN od drugih
# projekata (zaseban Supabase projekt, zaseban Vercel projekt, zaseban GitHub
# repozitorij) — radi neovisnog praćenja troškova i pristupa.
# =============================================================================

# --- Autentikacija -----------------------------------------------------------
# NAMJERNO UMIROVLJENA do završetka izrade asistenta (vidi README → Autentikacija).
# Cijeli sloj (Supabase Auth, prijava/registracija, uloge, middleware) je
# implementiran; ova zastavica ga samo drži isključenim. Kad se postavi na
# "true", aplikacija odmah traži prijavu i veže napredak uz stvarnog korisnika.
AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false

# --- Supabase (Postgres + pgvector + Auth + Storage) -------------------------
# Kreirajte NOVI, zaseban Supabase projekt (supabase.com) — regija eu-central-1.
NEXT_PUBLIC_SUPABASE_URL=https://VAS-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role ključ — NIKAD u klijentski kod, samo server/skripte
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude / Anthropic (generiranje odgovora, rerank) -----------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=3000
# Manji, brzi model za rerank dohvaćenih isječaka
RERANK_MODEL=claude-haiku-4-5-20251001

# --- Embeddinzi (OpenAI) -----------------------------------------------------
# Anthropic ne nudi embedding API — koristi se OpenAI text-embedding-3-small.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Glas: ASR (Whisper) i TTS za usmenu vježbu ------------------------------
# Audio snimke se NIKAD ne pohranjuju — samo transkript i metrike (vidi README).
ASR_PROVIDER=openai
ASR_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Ako se koristi zaseban ključ za govor, ostavite prazno da se preuzme OPENAI_API_KEY
SPEECH_API_KEY=

# --- RAG parametri -----------------------------------------------------------
RAG_TOP_K=10
RAG_RERANK_TOP_N=6
RAG_RERANK=true
RAG_CONTEXT_CHAR_BUDGET=11000
# Minimalna semantička sličnost ispod koje se isječak ne smatra pokrićem
RAG_MIN_SCORE=0.18
MAX_CHUNK_TOKENS=320
CHUNK_OVERLAP_TOKENS=60

# --- Ingest (lokalne putanje; datoteke se NIKAD ne commitaju) ----------------
PRIRUCNIK_DOCX_PATH=./materijali/prirucnik.docx
# Mapa s dopunskim izvorima (PDF) navedenima u priručniku
DOPUNSKI_DIR=./materijali/dopunski

# --- Identitet aplikacije ----------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Ponašanje potrošača u turizmu — AI asistent kolegija"
NEXT_PUBLIC_ASSISTANT_NAME="Vita"
NEXT_PUBLIC_USTANOVA="Veleučilište Baltazar Zaprešić"
# Autor priručnika — prikazuje se na naslovnici i stranici „O priručniku".
# Ostavite prazno ako potpis ne treba prikazivati.
NEXT_PUBLIC_AUTOR_PRIRUCNIKA="prof. dr. sc. Drago Ružić"

# Dijagnostika: 1 = API greške vraćaju i kratak tehnički trag (redigiran).
# Ostavite prazno u normalnom radu; uključite samo dok tražite uzrok kvara.
DIAGNOSTIKA=

# --- Usmeni razgovor (brzina) ---------------------------------------------
# Odgovor se SLUŠA, pa mora biti kratak; svaka sekunda čekanja osjeti se jače
# nego u chatu. Mjereno: pun pisani odgovor Sonnetom ~20-24 s, kratki usmeni
# Sonnetom ~8 s, Haikuom ~6 s.
# Haiku je najbrži, ali povremeno pogriješi u hrvatskom pravopisu; prebacite na
# claude-sonnet-5 ako vam je važnija jezična ispravnost od ~2 s brzine.
USMENI_MODEL=claude-haiku-4-5-20251001
# Kratak izlaz je glavni razlog ubrzanja — ne dizati bez potrebe:
USMENI_MAX_TOKENS=400
# Manje isječaka = manji ulaz i brži odgovor:
USMENI_TOP_K=6
